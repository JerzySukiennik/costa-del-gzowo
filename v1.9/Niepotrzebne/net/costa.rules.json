{
 "worlds": {
  "$world": {
   ".validate": "$world.matches(/^w[1-8]$/)",
   "slots": {
    ".read": "auth != null",
    "$slot": {
     ".write": "auth != null && $slot.matches(/^[0-3]$/) && (!data.exists() || data.child('pid').val() === newData.child('pid').val() || data.child('ts').val() < now - 45000 || (!newData.exists() && data.child('uid').val() === auth.uid))",
     ".validate": "newData.hasChildren(['uid','pid','ts','name','car','avatar'])",
     "uid": {
      ".validate": "newData.isString() && newData.val() === auth.uid"
     },
     "pid": {
      ".validate": "newData.isString() && newData.val().length <= 160 && newData.val().beginsWith(auth.uid)"
     },
     "ts": {
      ".validate": "newData.isNumber() && newData.val() <= now + 120000 && newData.val() >= now - 120000"
     },
     "name": {
      ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
     },
     "car": {
      ".validate": "newData.isString() && newData.val().length <= 16"
     },
     "avatar": {
      ".validate": "newData.isString() && newData.val().length <= 16"
     },
     "$other": {
      ".validate": false
     }
    }
   },
   "signal": {
    "$to": {
     ".read": "auth != null && root.child('costa/worlds/' + $world + '/slots/' + $to + '/uid').val() === auth.uid",
     ".write": "auth != null && root.child('costa/worlds/' + $world + '/slots/' + $to + '/uid').val() === auth.uid",
     "$from": {
      ".write": "auth != null && (root.child('costa/worlds/' + $world + '/slots/' + $from + '/uid').val() === auth.uid || root.child('costa/worlds/' + $world + '/slots/' + $to + '/uid').val() === auth.uid)",
      "$key": {
       ".validate": "newData.isString() && newData.val().length < 12000"
      }
     }
    }
   },
   "relay": {
    ".read": "auth != null",
    "$slot": {
     ".write": "auth != null && root.child('costa/worlds/' + $world + '/slots/' + $slot + '/uid').val() === auth.uid",
     ".validate": "newData.isString() && newData.val().length < 700"
    }
   },
   "$other": {
    ".validate": false
   },
   "vehicles": {
    ".read": "auth != null",
    "$vehicle": {
     ".write": "auth != null && $vehicle.matches(/^[0-9]$/)",
     ".validate": "newData.hasChildren(['owner','uid']) && newData.child('uid').val() === auth.uid && newData.child('owner').isNumber() && root.child('costa/worlds/' + $world + '/slots/' + newData.child('owner').val() + '/uid').val() === auth.uid",
     "owner": {
      ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
     },
     "uid": {
      ".validate": "newData.isString()"
     },
     "$other": {
      ".validate": false
     }
    }
   }
  }
 },
 "$other": {
  ".validate": false
 }
}